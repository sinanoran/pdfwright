<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      Globalization stays ON, and the library never depends on it. Every number
      that reaches a PDF is written with CultureInfo.InvariantCulture (a content
      stream that says "12,5 0 Td" is a corrupt file on a German machine), and a
      test that renders under a culture that uses a comma comes with slice S1, the writer. Text direction,
      scripts and line breaking come from the library's own Unicode tables, never
      from the machine's ICU or NLS.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Repository">
    <!--
      The release workflow passes -p:Version from the git tag, so a published
      package cannot disagree with the tag that produced it. This is what a
      local `dotnet pack` produces, and it is deliberately not a release version.
    -->
    <VersionPrefix>0.0.1</VersionPrefix>
    <Authors>Sinan Oran</Authors>
    <Company>Pdfwright contributors</Company>
    <Product>Pdfwright</Product>
    <Copyright>Copyright (c) Pdfwright contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sinanoran/pdfwright</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sinanoran/pdfwright</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
