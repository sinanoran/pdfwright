<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Turns the pinned Unicode data files (data/unicode) into the library's tables (src/Pdfwright/Unicode/BidiTables.g.cs).
    Run by hand when the Unicode version is raised; a test regenerates the output and compares, so it cannot drift.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pdfwright.UnicodeGen</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
