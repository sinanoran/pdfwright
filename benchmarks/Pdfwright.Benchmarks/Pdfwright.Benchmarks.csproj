<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The measuring tools (section 7 of docs/plan-0.1.md): a fresh-process harness for cold time and peak
    working set, the data of the standard scenarios, and BenchmarkDotNet for warm time and allocations.
    Not packed and not part of a release; `dotnet build Pdfwright.slnx` builds it so it cannot rot.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pdfwright.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pdfwright\Pdfwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Baselines\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\Pdfwright.Tests\Fonts\NotoSans-Regular.ttf" Link="fonts\NotoSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\Pdfwright.Tests\Fonts\NotoSans-Bold.ttf" Link="fonts\NotoSans-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\Pdfwright.Tests\Fonts\NotoSansArabic-Regular.ttf" Link="fonts\NotoSansArabic-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\Pdfwright.Tests\Fonts\NotoSansDevanagari-Regular.ttf" Link="fonts\NotoSansDevanagari-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
